<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:openDrawer="start">

    <!-- Conteúdo Principal -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_background_dark"
        tools:context=".ui.DashboardActivity">

        <!-- Barra de Navegação (Fixa no fundo) -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigationView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/header_background_shape"
            app:backgroundTint="@color/app_primary_light"
            app:itemIconTint="@color/bottom_nav_color_selector"
            app:itemTextColor="@color/bottom_nav_color_selector"
            app:labelVisibilityMode="labeled"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:menu="@menu/bottom_nav_menu" />

        <!-- Botão Flutuante (FAB) -->
        <!-- Adicionei margem inferior para não grudar na barra -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAdicionarDoacao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:src="@drawable/ic_add"
            app:backgroundTint="@color/app_accent_green"
            app:tint="@color/app_primary_dark"
            app:layout_constraintBottom_toTopOf="@id/bottomNavigationView"
            app:layout_constraintEnd_toEndOf="parent"
            app:fabSize="normal"
            android:contentDescription="Registrar nova doação"/>

        <!-- ScrollView para o conteúdo (Acima da barra) -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/contentScrollView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/bottomNavigationView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="80dp">

                <!-- Fundo do Cabeçalho -->
                <View
                    android:id="@+id/headerBackground"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:background="@drawable/header_background_shape"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Barra Superior -->
                <ImageButton
                    android:id="@+id/menuButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    android:src="@drawable/ic_menu"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/textViewTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Painel"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/menuButton"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/menuButton" />

                <!-- Card: Estoque -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardEstoque"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="24dp"
                    app:cardBackgroundColor="@color/app_primary_light"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:layout_constraintTop_toBottomOf="@id/textViewTitle">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/textViewEstoqueLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Estoque Total"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <!-- Gráfico Simulado -->
                        <FrameLayout
                            android:id="@+id/pieChartEstoqueContainer"
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/shape_circle_solid"
                            android:backgroundTint="@color/app_background_dark"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/textViewEstoqueLabel">

                            <!-- Texto dentro do gráfico -->
                            <TextView
                                android:id="@+id/textViewEstoqueTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="151400"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:layout_gravity="center"/>
                        </FrameLayout>

                        <!-- Legenda -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="24dp"
                            app:layout_constraintStart_toEndOf="@id/pieChartEstoqueContainer"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@id/pieChartEstoqueContainer"
                            app:layout_constraintBottom_toBottomOf="@id/pieChartEstoqueContainer">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Não Perecível"
                                android:textColor="@color/white_80"
                                android:drawableStart="@drawable/shape_circle_solid"
                                android:drawableTint="@color/app_accent_green"
                                android:drawablePadding="8dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Perecível"
                                android:textColor="@color/white_80"
                                android:drawableStart="@drawable/shape_circle_solid"
                                android:drawableTint="@color/white_60"
                                android:drawablePadding="8dp"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card: Atenção -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAtencao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/app_accent_yellow"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:layout_constraintTop_toBottomOf="@id/cardEstoque">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawablePadding="12dp"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:text="Atenção: 15 itens vencem nesta semana"
                        android:textColor="@color/app_primary_dark"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_warning"
                        app:drawableTint="@color/app_primary_dark" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Grid de Métricas (LinearLayout Horizontal para dividir 50/50) -->
                <LinearLayout
                    android:id="@+id/metricsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    android:baselineAligned="false"
                    app:layout_constraintTop_toBottomOf="@id/cardAtencao">

                    <!-- Card: Doações -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:cardBackgroundColor="@color/app_primary_light"
                        app:cardCornerRadius="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Doações Mês"
                                android:textColor="@color/white_80"
                                android:textSize="14sp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1516"
                                android:textColor="@color/white"
                                android:textSize="32sp"
                                android:textStyle="bold"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Card: Próximas Entregas -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        app:cardBackgroundColor="@color/app_primary_light"
                        app:cardCornerRadius="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Próx. Entregas"
                                android:textColor="@color/white_80"
                                android:textSize="14sp"/>

                            <!-- Lista simplificada -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="• Lar dos Idosos"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:layout_marginTop="8dp"
                                android:maxLines="1"
                                android:ellipsize="end"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="• Creche Criança..."
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:maxLines="1"
                                android:ellipsize="end"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="• Sopão Comunit..."
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:maxLines="1"
                                android:ellipsize="end"/>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Card: Doações do Mês (Gráfico Grande) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDoacoesMes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/app_primary_light"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:layout_constraintTop_toBottomOf="@id/metricsRow">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Histórico de Doações"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="150dp"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/shape_rounded_corners"
                            android:backgroundTint="@color/app_background_dark">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Gráfico de Barras (Em Breve)"
                                android:textColor="@color/white_60"
                                android:layout_gravity="center"/>
                        </FrameLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Menu Lateral -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/app_primary_dark"
        app:headerLayout="@layout/nav_header_main"
        app:itemIconTint="@color/white_60"
        app:itemTextColor="@color/white"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>


