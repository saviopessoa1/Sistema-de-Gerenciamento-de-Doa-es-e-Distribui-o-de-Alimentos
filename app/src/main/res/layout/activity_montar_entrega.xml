<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_background_dark"
    tools:context=".ui.MontarEntregaActivity">

    <!-- CABEÇALHO -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="16dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Montar Nova Entrega"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@+id/backButton"
            app:layout_constraintStart_toStartOf="@+id/backButton"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- CONTAINER INSTITUIÇÕES (Será escondido ao buscar) -->
    <ScrollView
        android:id="@+id/institutionsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Instituições Prioritárias"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <!-- Card 1 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/app_primary_light"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="8dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">
                    <TextView
                        android:id="@+id/titleLar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Lar dos Idosos"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/btnSelecionarLar"/>
                    <TextView
                        android:id="@+id/labelUrgenciaLar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Urgência: "
                        android:textColor="@color/white_60"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/titleLar"/>
                    <TextView
                        android:id="@+id/textUrgenciaLar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alta"
                        android:textColor="@color/app_accent_red"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/labelUrgenciaLar"
                        app:layout_constraintTop_toTopOf="@id/labelUrgenciaLar" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelecionarLar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selecionar"
                        android:backgroundTint="@color/app_accent_green"
                        android:textColor="@color/app_primary_dark"
                        app:cornerRadius="12dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/app_primary_light"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="8dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">
                    <TextView
                        android:id="@+id/titleCreche"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Creche criança feliz"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/btnSelecionarCreche"/>
                    <TextView
                        android:id="@+id/labelUrgenciaCreche"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Urgência: "
                        android:textColor="@color/white_60"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/titleCreche"/>
                    <TextView
                        android:id="@+id/textUrgenciaCreche"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Média"
                        android:textColor="@color/app_accent_yellow"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/labelUrgenciaCreche"
                        app:layout_constraintTop_toTopOf="@id/labelUrgenciaCreche" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelecionarCreche"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selecionar"
                        android:backgroundTint="@color/app_accent_green"
                        android:textColor="@color/app_primary_dark"
                        app:cornerRadius="12dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/app_primary_light"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="16dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">
                    <TextView
                        android:id="@+id/titleSopao"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Sopão Comunitário"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/btnSelecionarSopao"/>
                    <TextView
                        android:id="@+id/labelUrgenciaSopao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Urgência: "
                        android:textColor="@color/white_60"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/titleSopao"/>
                    <TextView
                        android:id="@+id/textUrgenciaSopao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Normal"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/labelUrgenciaSopao"
                        app:layout_constraintTop_toTopOf="@id/labelUrgenciaSopao" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelecionarSopao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selecionar"
                        android:backgroundTint="@color/app_accent_green"
                        android:textColor="@color/app_primary_dark"
                        app:cornerRadius="12dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- BARRA DE BUSCA + LISTA (Ocupa o resto da tela) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/labelItens"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Itens em estoque (FIFO)"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Buscar itens..."
            android:background="@drawable/shape_rounded_corners"
            android:backgroundTint="@color/app_primary_light"
            android:textColorHint="@color/white_60"
            android:textColor="@color/white"
            android:padding="12dp"
            android:drawableStart="@drawable/ic_search"
            android:drawableTint="@color/white_60"
            android:drawablePadding="8dp"
            android:layout_marginBottom="8dp"/>

        <!-- A LISTA AGORA TEM SCROLL PRÓPRIO E CRESCE/ENCOLHE -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/itensEstoqueRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp"/>
    </LinearLayout>

    <!-- RODAPÉ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/footerCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/app_primary_light"
        app:cardCornerRadius="0dp"
        app:cardElevation="8dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView
                android:id="@+id/labelInstituicao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Instituição:"
                android:textColor="@color/white_60"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textInstituicaoSelecionada"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Nenhuma selecionada"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/labelInstituicao"
                app:layout_constraintEnd_toStartOf="@+id/btnProximo"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProximo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Próximo"
                android:backgroundTint="@color/app_accent_green"
                android:textColor="@color/app_primary_dark"
                app:cornerRadius="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>


