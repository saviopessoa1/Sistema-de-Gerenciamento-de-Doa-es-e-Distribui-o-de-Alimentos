<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/app_header_curve"
    app:cardCornerRadius="16dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Título da Instituição -->
        <TextView
            android:id="@+id/titleInstituicao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Creche Criança Feliz"
            android:textColor="@color/app_text_white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/iconConcluido"/>

        <!-- Ícone de Concluído (NOVO) -->
        <ImageView
            android:id="@+id/iconConcluido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_save"
            app:tint="@android:color/holo_green_dark"
            app:layout_constraintEnd_toStartOf="@+id/btnDetalhes"
            app:layout_constraintTop_toTopOf="@id/titleInstituicao"
            app:layout_constraintBottom_toBottomOf="@id/titleInstituicao"
            android:layout_marginEnd="8dp"
            android:visibility="gone" /> <!-- Começa escondido -->

        <!-- Nível de Urgência (Para Pendentes) -->
        <TextView
            android:id="@+id/textUrgencia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Urgência: Alta"
            android:textColor="@color/app_text_grey"
            android:textSize="14sp"
            android:visibility="visible"
            app:layout_constraintStart_toStartOf="@id/titleInstituicao"
            app:layout_constraintTop_toBottomOf="@id/titleInstituicao" />

        <!-- Agendamento (Para Pendentes) -->
        <TextView
            android:id="@+id/textAgendado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Agendado: 15/05/2025"
            android:textColor="@color/app_text_grey"
            android:textSize="14sp"
            android:visibility="visible"
            app:layout_constraintStart_toStartOf="@id/titleInstituicao"
            app:layout_constraintTop_toBottomOf="@id/textUrgencia" />

        <!-- Data de Entrega (Para Concluídos) (NOVO) -->
        <TextView
            android:id="@+id/textEntregue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Entregue: 15/05/2025"
            android:textColor="@color/app_text_grey"
            android:textSize="14sp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/titleInstituicao"
            app:layout_constraintTop_toBottomOf="@id/textUrgencia" />

        <!-- Endereço -->
        <TextView
            android:id="@+id/textEndereco"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Avenida do Pôr do Sol, 1200 - Vila Nova"
            android:textColor="@color/app_text_grey"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@id/titleInstituicao"
            app:layout_constraintTop_toBottomOf="@id/textAgendado"
            app:layout_constraintEnd_toStartOf="@+id/btnDetalhes"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- Botão Detalhes -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetalhes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detalhes"
            android:backgroundTint="@android:color/holo_green_dark"
            app:cornerRadius="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>


