<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_primary_dark"
    tools:context=".ui.RegistrarDoacaoActivity">

    <!-- Formulário Superior (Fixo) -->
    <LinearLayout
        android:id="@+id/formContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registrar Nova Doação"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- Campos do Formulário -->
        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nome do item"
            android:background="@drawable/shape_rounded_corners"
            android:backgroundTint="@color/app_primary_light"
            android:textColorHint="@color/white_60"
            android:textColor="@color/white"
            android:padding="12dp"
            android:layout_marginBottom="8dp"/>

        <!-- ... (Adicionar outros campos: Data, Qtd, Voluntário, etc.) ... -->

        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Perecível"
                android:textColor="@color/white"
                android:buttonTint="@color/white"/>
            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Não perecível"
                android:checked="true"
                android:textColor="@color/white"
                android:buttonTint="@color/white"/>
        </RadioGroup>

        <Button
            android:id="@+id/adicionarItemButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Adicionar Item"
            android:backgroundTint="@color/app_accent_green"
            android:textColor="@color/black"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Itens Registrados"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="18sp"/>

    </LinearLayout>

    <!-- Lista com Scroll (Somente esta parte rola) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/itensRegistradosRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/formContainer"
        app:layout_constraintBottom_toTopOf="@+id/confirmarDoacaoButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_doacao_registrada"/>

    <!-- Botão de Confirmar (Fixo) -->
    <Button
        android:id="@+id/confirmarDoacaoButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Confirmar Doação"
        android:backgroundTint="@color/app_accent_green"
        android:textColor="@color/black"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>


